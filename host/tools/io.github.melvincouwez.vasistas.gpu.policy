<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Vasistas</vendor>
  <action id="io.github.melvincouwez.vasistas.gpu">
    <description>Prêter la carte graphique dédiée à Windows</description>
    <message>Vasistas veut prêter la carte graphique dédiée à la machine virtuelle Windows</message>
    <icon_name>io.github.melvincouwez.Vasistas</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/vasistas-gpu</annotate>
  </action>
</policyconfig>
