#!/bin/bash
# Assistant système de Vasistas : prête la carte graphique dédiée à la VM (pilote vfio-pci)
# ou la rend à Linux. Appelé par pkexec ; n'accepte que des cartes d'affichage dédiées et les
# fonctions audio/USB de leur emplacement, jamais la carte qui affiche le bureau.
#   vasistas-gpu bind 0000:64:00.0 0000:64:00.1
#   vasistas-gpu unbind 0000:64:00.0 0000:64:00.1
set -eu
action=${1:-}; shift || true
[ "$action" = bind ] || [ "$action" = unbind ] || { echo "usage : $0 bind|unbind ADRESSE..." >&2; exit 2; }
[ $# -gt 0 ] || { echo "aucune adresse" >&2; exit 2; }

for addr in "$@"; do
    [[ "$addr" =~ ^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$ ]] || { echo "adresse invalide : $addr" >&2; exit 2; }
    dev=/sys/bus/pci/devices/$addr
    [ -d "$dev" ] || { echo "périphérique absent : $addr" >&2; exit 2; }
    fn0=$(dirname "$dev")/${addr%.*}.0
    [[ "$(cat "$fn0/class")" == 0x03* ]] || { echo "$addr n'est pas sur une carte graphique" >&2; exit 3; }
    [ "$(cat "$fn0/boot_vga" 2>/dev/null || echo 0)" != 1 ] || { echo "refus : carte du bureau" >&2; exit 3; }
done

modprobe vfio-pci
for addr in "$@"; do
    dev=/sys/bus/pci/devices/$addr
    if [ "$action" = bind ]; then
        echo vfio-pci > "$dev/driver_override"
    else
        echo > "$dev/driver_override"
    fi
    if [ -e "$dev/driver" ]; then
        echo "$addr" > "$dev/driver/unbind"
    fi
    echo "$addr" > /sys/bus/pci/drivers_probe
    echo "$addr : $(basename "$(readlink "$dev/driver" 2>/dev/null || echo aucun)")"
done
