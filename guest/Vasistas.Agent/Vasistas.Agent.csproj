<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Vasistas.Agent</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- exe publié : ni chemin de compilation ni adresse du dépôt git dans les binaires -->
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PathMap>$(MSBuildProjectDirectory)=Vasistas.Agent</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.26100.9169" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <EmbeddedResource Include="native/libzstd.dll.gz" LogicalName="libzstd.dll.gz" />
  </ItemGroup>
  <!-- UI Automation COM (UIA3) : types d'interop embarqués dans l'exe, qui reste seul à copier
       (update_agent.py n'envoie que lui). Le paquet les veut en DLL à part : on reprend la main
       après sa cible. -->
  <Target Name="EmbedUiaInterop" AfterTargets="EmbeddingAssemblyInteropUIAutomationClient" BeforeTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePath Condition=" '%(FileName)' == 'Interop.UIAutomationClient' ">
        <EmbedInteropTypes>true</EmbedInteropTypes>
        <Private>false</Private>
      </ReferencePath>
    </ItemGroup>
  </Target>
</Project>
