+NTSTATUS VioGpuDod::ControlInterrupt(_In_ CONST DXGK_INTERRUPT_TYPE InterruptType, _In_ BOOLEAN EnableInterrupt)
+{
+    PAGED_CODE();
+
+    if (InterruptType == DXGK_INTERRUPT_DISPLAYONLY_PRESENT_PROGRESS)
+    {
+        return STATUS_SUCCESS;
+    }
+    if (InterruptType != DXGK_INTERRUPT_DISPLAYONLY_VSYNC)
+    {
+        return STATUS_NOT_IMPLEMENTED;
+    }
+    if (!(g_VsyncMode & VSYNC_TIMER))
+    {
+        return STATUS_SUCCESS;
+    }
+    if (EnableInterrupt && m_pVsyncTimer == NULL)
+    {
+        // minuterie haute résolution : 16,67 ms exactes au lieu du pas de 15,6 ms
+        m_pVsyncTimer = ExAllocateTimer(VsyncTimerCallback, this, EX_TIMER_HIGH_RESOLUTION);
+        if (m_pVsyncTimer == NULL)
+        {
+            return STATUS_INSUFFICIENT_RESOURCES;
+        }
+    }
+    if (EnableInterrupt && !m_VsyncEnabled)
+    {
+        m_VsyncEnabled = TRUE;
+        ExSetTimer(m_pVsyncTimer, -166667LL, 166667LL, NULL);
+    }
+    else if (!EnableInterrupt && m_VsyncEnabled)
+    {
+        m_VsyncEnabled = FALSE;
+        ExCancelTimer(m_pVsyncTimer, NULL);
+    }
+    return STATUS_SUCCESS;
+}
+
+VOID VioGpuDod::StopVsync(VOID)
+{
+    PAGED_CODE();
+
+    if (m_pVsyncTimer != NULL)
+    {
+        m_VsyncEnabled = FALSE;
+        EXT_DELETE_PARAMETERS params;
+        ExInitializeDeleteTimerParameters(&params);
+        ExDeleteTimer(m_pVsyncTimer, TRUE, TRUE, &params);
+        m_pVsyncTimer = NULL;
+    }
+}
