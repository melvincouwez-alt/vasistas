+// KeQueryInterruptTimePrecise écrit aussi le compteur QPC : son paramètre n'est pas facultatif
+static LONGLONG InterruptTimeNow(VOID)
+{
+    ULONG64 qpc;
+    return (LONGLONG)KeQueryInterruptTimePrecise(&qpc);
+}
+
+NTSTATUS VioGpuDod::GetScanLine(_Inout_ DXGKARG_GETSCANLINE *pGetScanLine)
+{
+    // balayage simulé : position dans la période de 16,67 ms depuis le dernier vsync, les
+    // dernières 4 % de la période comptent comme retour vertical
+    const LONGLONG period = 166667;
+    UINT height = m_CurrentMode.SrcModeHeight ? m_CurrentMode.SrcModeHeight : 1;
+    UINT total = height + height / 25 + 1;
+    LONGLONG phase = (InterruptTimeNow() - m_LastVsync) % period;
+    if (phase < 0)
+    {
+        phase = 0;
+    }
+    UINT line = (UINT)(phase * total / period);
+    pGetScanLine->InVerticalBlank = line >= height;
+    pGetScanLine->ScanLine = line >= height ? 0 : line;
+    return STATUS_SUCCESS;
+}
+
+BOOLEAN VioGpuDod::VsyncNotify(PVOID Context)
+{
+    VioGpuDod *pDod = reinterpret_cast<VioGpuDod *>(Context);
+    pDod->m_LastVsync = InterruptTimeNow();
+    DXGKARGCB_NOTIFY_INTERRUPT_DATA notify = {};
+    notify.InterruptType = DXGK_INTERRUPT_DISPLAYONLY_VSYNC;
+    notify.DisplayOnlyVsync.VidPnTargetId = 0;
+    pDod->m_DxgkInterface.DxgkCbNotifyInterrupt(pDod->m_DxgkInterface.DeviceHandle, &notify);
+    return TRUE;
+}
+
+VOID VioGpuDod::VsyncTimerCallback(PEX_TIMER Timer, PVOID Context)
+{
+    UNREFERENCED_PARAMETER(Timer);
+    VioGpuDod *pDod = reinterpret_cast<VioGpuDod *>(Context);
+    if (!pDod->m_VsyncEnabled || !pDod->IsDriverActive())
+    {
+        return;
+    }
+    if (!(g_VsyncMode & VSYNC_NOTIFY))
+    {
+        pDod->m_LastVsync = InterruptTimeNow();
+        return;
+    }
+    // DxgkCbNotifyInterrupt doit être appelé au niveau de l'interruption du périphérique
+    BOOLEAN ret = FALSE;
+    if (NT_SUCCESS(pDod->m_DxgkInterface.DxgkCbSynchronizeExecution(pDod->m_DxgkInterface.DeviceHandle,
+                                                                     VsyncNotify, pDod, 0, &ret)))
+    {
+        pDod->m_DxgkInterface.DxgkCbQueueDpc(pDod->m_DxgkInterface.DeviceHandle);
+    }
+}
