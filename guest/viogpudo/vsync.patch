+static VOID ReadVsyncMode(_In_ UNICODE_STRING *pRegistryPath)
+{
+    PAGED_CODE();
+    // chemin absolu terminé par un zéro pour les fonctions Rtl*Registry*
+    USHORT len = pRegistryPath->Length;
+    PWCHAR path = (PWCHAR)ExAllocatePoolWithTag(PagedPool, len + sizeof(WCHAR), 'VGDV');
+    if (path == NULL)
+    {
+        return;
+    }
+    RtlCopyMemory(path, pRegistryPath->Buffer, len);
+    path[len / sizeof(WCHAR)] = 0;
+    ULONG always = 0, once = 0;
+    RTL_QUERY_REGISTRY_TABLE table[3] = {};
+    table[0].Flags = RTL_QUERY_REGISTRY_DIRECT | RTL_QUERY_REGISTRY_TYPECHECK;
+    table[0].Name = (PWSTR)L"VasistasVsync";
+    table[0].EntryContext = &always;
+    table[0].DefaultType = (REG_DWORD << RTL_QUERY_REGISTRY_TYPECHECK_SHIFT) | REG_NONE;
+    table[1].Flags = RTL_QUERY_REGISTRY_DIRECT | RTL_QUERY_REGISTRY_TYPECHECK;
+    table[1].Name = (PWSTR)L"VasistasVsyncOnce";
+    table[1].EntryContext = &once;
+    table[1].DefaultType = (REG_DWORD << RTL_QUERY_REGISTRY_TYPECHECK_SHIFT) | REG_NONE;
+    RtlQueryRegistryValues(RTL_REGISTRY_ABSOLUTE | RTL_REGISTRY_OPTIONAL, path, table, NULL, NULL);
+    if (once != 0)
+    {
+        RtlDeleteRegistryValue(RTL_REGISTRY_ABSOLUTE, path, L"VasistasVsyncOnce");
+        g_VsyncMode = once;
+    }
+    else
+    {
+        g_VsyncMode = always;
+    }
+    ExFreePoolWithTag(path, 'VGDV');
+}
